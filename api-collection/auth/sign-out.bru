meta {
  name: sign-out
  type: http
  seq: 13
}

post {
  url: {{authUrl}}/sign-out
  body: json
  auth: none
}

headers {
  Origin: {{origin}}
  Cookie: {{sessionCookie}}
  Content-Type: application/json
}

body:json {
  {}
}

assert {
  res.status: eq 200
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("sessionCookie", "");
    bru.setEnvVar("token", "");
  }
}
