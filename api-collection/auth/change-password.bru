meta {
  name: change-password
  type: http
  seq: 12
}

post {
  url: {{authUrl}}/change-password
  body: json
  auth: none
}

headers {
  Origin: {{origin}}
  Cookie: {{sessionCookie}}
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{newPassword}}",
    "revokeOtherSessions": false
  }
}

assert {
  res.status: eq 200
}

docs {
  Changes the password from {{password}} to {{newPassword}}. Afterwards sign-in with {{password}}
  fails; swap the two environment values or sign up a fresh user.
}
